# Receta de versiones del cascarón en iOS: la única fuente de las versiones fijas.
#
# La leen el workflow de entrega (.github/workflows/framework-concept-ios.yml, que la carga a $GITHUB_ENV), la VM del
# runner y el escenario de agente. verificar.sh compara lo instalado contra este archivo.
# Formato: CLAVE=valor, una por línea, sin comillas ni espacios (sirve para $GITHUB_ENV y para «source»).
# Regla del PO: versiones explícitas siempre; nada de «la última».
#
# Combinación medida en la VM el 2026-11-01 y en CI el 2026-11-02.

# XCODE (instalador .xip fijo en Google Drive; Apple no publica Xcode sin cuenta)
XCODE_VERSION=26.0
XCODE_BUILD=17A324
XCODE_FILE_INSTALLER=Xcode_26_Universal.xip
XCODE_XIP_SHA256=848f8de2c9f91ef2dad4eec8ff88655222a08f3eb32c4083432c51ae2480a70f
XCODE_GOOGLE_FILE_INSTALLER_ID=1GoDmCUBOMKM5nnXCXxxnAgoKpSwZvaMP
GDOWN_VERSION=5.2.0

# SIMULADOR (iOS 26.0.1)
IOS_RUNTIME=26.0
IOS_RUNTIME_BUILD=23A8464
SIM_DEVICE_TYPE=com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro

# DOTNET: el SDK es el de global.json de la demo (verificar.sh comprueba que coincidan). El script de instalación va
# fijado por commit de dotnet/install-scripts.
DOTNET_VERSION=10.0.400
DOTNET_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/dotnet/install-scripts/e5cf1dd2d1540ed05ac84f8eb8c5cdec2807621e/src/dotnet-install.sh

# WORKLOADS por archivo de reversión (manifiesto/banda), no por «workload set»: ningún set de la banda 10.0.400
# (10.0.400 a 10.0.403) trae ios 26.0; traen 26.5, 27.0 o 27.1, que exigen un Xcode más nuevo («requires Xcode 27.1»).
# Los manifiestos de toda la familia 10.0 son de la banda 10.0.100, así que funcionan con el SDK 10.0.400 sin tocar
# global.json (que también compila Android).
WORKLOAD_IOS_MANIFEST=26.0.11017/10.0.100
WORKLOAD_MAUI_MANIFEST=10.0.0/10.0.100
