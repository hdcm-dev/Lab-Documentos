@* El mensaje de error de un campo, si lo hay. Se muestra después del intento, debajo del requisito. *@
@if (!string.IsNullOrEmpty(Texto))
{
    <span class="fc-campo__mensaje" data-testid="error-@Campo">@Texto</span>
}

@code {
    [Parameter] public string? Texto { get; set; }

    [Parameter, EditorRequired] public string Campo { get; set; } = string.Empty;
}
