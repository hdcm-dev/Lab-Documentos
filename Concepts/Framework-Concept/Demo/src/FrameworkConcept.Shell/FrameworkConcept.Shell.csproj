<Project Sdk="Microsoft.NET.Sdk">

  <!-- El cascarón (P3): app MAUI que se actualiza SÓLO por tienda. Lleva las pantallas XAML propias, el
       actualizador (el de Core, con sus adaptadores), el servidor de contenido, el puente, el catálogo, la base
       SQLite con el outbox y un único HybridWebView. Dos destinos con el mismo comportamiento: Android e iOS.

       Cómo se compila (desde la raíz de la demo):
         Android, en el contenedor (Linux):
           scripts/contenedor.sh dotnet build src/FrameworkConcept.Shell -c Debug -f net10.0-android \
             -p:RuntimeIdentifier=android-arm64 -p:AndroidPackageFormat=apk \
             -p:FcCanalUrl=https://<servidor-del-canal>
           android-arm64 es para un teléfono; android-x64, para el emulador.
         iOS, en una Mac con Xcode y el workload ios (no hay compilación de iOS fuera de macOS):
           dotnet build src/FrameworkConcept.Shell -c Debug -f net10.0-ios -p:RuntimeIdentifier=iossimulator-arm64
           iossimulator-arm64 es para el simulador en una Mac con Apple silicon; ios-arm64, para un teléfono (pide
           perfil de aprovisionamiento). Con Xcode 26 y un workload ios más nuevo: -p:FcDestinos=net10.0-ios26.0
           -f net10.0-ios26.0. README.md, «El cascarón en iOS», cuenta cómo se instala y se lee la bitácora. -->
  <Import Project="../../versionado/version-cascaron.props" />

  <PropertyGroup>
    <!-- Destinos: net10.0-android;net10.0-ios. La restauración de NuGet abarca TODOS los destinos de la lista aunque
         se compile uno solo con -f, y falla (NETSDK1147) si falta el workload de alguno. Por eso la lista depende de
         la máquina: Linux y Windows, sólo Android (el workload de iOS no compila fuera de macOS); macOS, iOS y además
         Android si el SDK de .NET tiene instalado el workload android. Se puede fijar a mano:
         -p:FcDestinos="net10.0-android;net10.0-ios". -->
    <_FcAndroidEnMac Condition="Exists('$([MSBuild]::EnsureTrailingSlash($(NetCoreRoot)))packs/Microsoft.Android.Sdk.Darwin')">net10.0-android;</_FcAndroidEnMac>
    <FcDestinos Condition="'$(FcDestinos)' == '' And $([MSBuild]::IsOSPlatform('osx'))">$(_FcAndroidEnMac)net10.0-ios</FcDestinos>
    <FcDestinos Condition="'$(FcDestinos)' == ''">net10.0-android</FcDestinos>
    <TargetFrameworks>$(FcDestinos)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>FrameworkConcept.Shell</RootNamespace>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Framework Concept</ApplicationTitle>
    <!-- En el teléfono de medida sólo se instalan paquetes com.frameworkconcept.* -->
    <ApplicationId>com.frameworkconcept.demo</ApplicationId>

  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <!-- Piso de Android del ensayo E01 (24). El piso real del contenido es el WebView ≥ 94 (P1, C-3),
         que se comprueba al arrancar, no acá. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- El APK se instala con «adb install», no con el despliegue rápido del IDE: los ensamblados .NET tienen que
         viajar DENTRO del APK también en Debug. Sin esto, el proceso aborta al abrir («No assemblies found …
         Fast Deployment»), visto en el emulador el 2026-10-26. Misma receta que R2 §8. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios'">
    <!-- Piso de iOS: 16.4, el ParametrosDeProducto.IosMinimo de Core (P1, P9); si uno cambia, cambia el otro. En iOS
         el motor web no se actualiza aparte: WKWebView es el WebKit del sistema, así que el piso del sistema ES el
         piso del motor (el equivalente del «WebView ≥ 94» de Android). Por qué 16.4 y no 15: el runtime de Blazor
         WebAssembly de .NET 10 se publica con SIMD de WebAssembly (WasmEnableSIMD, activo por defecto), que WebKit
         trae recién con Safari 16.4; con un WebKit anterior el contenido no arranca. Como la tienda no instala por
         debajo de MinimumOSVersion, el chequeo del motor queda hecho al instalar (Hosting/MotorWeb.cs). -->
    <SupportedOSPlatformVersion>16.4</SupportedOSPlatformVersion>

    <!-- P4 — Keychain en el simulador: sin un grupo de acceso firmado en la app, SecItemAdd devuelve
         errSecMissingEntitlement (-34018). La compilación del simulador firma ad hoc con este archivo; en un teléfono
         lo firma el perfil de aprovisionamiento. Ver Platforms/iOS/Entitlements.plist. -->
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>

    <!-- iOS no permite generar código en ejecución, y el cascarón compila TODO de antemano, sin intérprete. EF Core
         lo resiste porque no arma nada al vuelo: el modelo y las consultas salen compilados de Data/Compilado/
         (scripts/modelo-compilado.sh). Sin eso, el Release aborta al abrir («Model building is not supported when
         publishing with NativeAOT», visto en el simulador el 2026-11-01; el Debug no lo muestra porque corre con
         intérprete). README.md, «La base del cascarón sin código dinámico». -->
  </PropertyGroup>

  <!-- En el simulador la firma es ad hoc («-»): no hace falta certificado de Apple, y las entitlements quedan igual
       dentro del binario. Sin esto, con CodesignEntitlements el build busca una identidad en el llavero y falla. -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios' And $(RuntimeIdentifier.StartsWith('iossimulator'))">
    <CodesignKey Condition="'$(CodesignKey)' == ''">-</CodesignKey>
  </PropertyGroup>

  <!-- Archivos de Android que no viven en Platforms/Android/ (la guía los cita por ruta y línea, por eso no se movieron):
       el cofre del Keystore y la actividad del redirect OIDC. En iOS los reemplazan Platforms/iOS/Auth/CofreDeSesion.cs
       y ASWebAuthenticationSession (WebAuthenticator no necesita una pantalla propia para la vuelta). -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'android'">
    <Compile Remove="Auth/CofreDeSesion.cs" />
    <Compile Remove="Auth/CallbackDeAutenticacion.cs" />
  </ItemGroup>

  <!-- Configuración del canal. Se cambia al compilar, sin tocar el código:
         -p:FcCanalUrl=https://xxxx.trycloudflare.com   raíz del servidor estático del canal (P2: sólo HTTPS)
         -p:FcCanal=dev                                 dev, beta o prod: cada canal es un índice distinto
         -p:FcReceptorUrl=https://...                   adonde se envían las respuestas (por defecto, el mismo servidor)
         -p:FcKeyId=demo-2026                           keyId de claves/publica-demo.pem (lo fija FrameworkConcept.Tools)
         -p:FcOidcAutoridad=https://203.0.113.10:8443/realms/fc-demo   emisor OIDC (P4, folio 038); vacío = sesión por dispositivo
         -p:FcOidcClienteId=fc-demo-app                 cliente público del realm (infra/keycloak/)
         -p:FcPantallasDeSesion=Contenido               quién muestra el ingreso y el desbloqueo: Contenido (la puerta de
                                                        sesión del contenido, por defecto) o Cascaron (pantallas XAML)
         -p:FcModoDeIngreso=Formulario                  cómo se ingresa con la cuenta: Formulario (usuario y clave en la app,
                                                        por defecto) o Navegador (Custom Tab, OIDC code + PKCE)
       Los valores quedan grabados en el ensamblado y los lee ConfiguracionDelCascaron. -->
  <PropertyGroup>
    <FcCanal Condition="'$(FcCanal)' == ''">dev</FcCanal>
    <FcCanalUrl Condition="'$(FcCanalUrl)' == ''">https://canal.invalid</FcCanalUrl>
    <FcReceptorUrl Condition="'$(FcReceptorUrl)' == ''">$(FcCanalUrl)</FcReceptorUrl>
    <FcKeyId Condition="'$(FcKeyId)' == ''">demo-2026</FcKeyId>
    <FcOidcClienteId Condition="'$(FcOidcClienteId)' == ''">fc-demo-app</FcOidcClienteId>
    <FcPantallasDeSesion Condition="'$(FcPantallasDeSesion)' == ''">Contenido</FcPantallasDeSesion>
    <FcModoDeIngreso Condition="'$(FcModoDeIngreso)' == ''">Formulario</FcModoDeIngreso>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcCanal</_Parameter1>
      <_Parameter2>$(FcCanal)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcCanalUrl</_Parameter1>
      <_Parameter2>$(FcCanalUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcReceptorUrl</_Parameter1>
      <_Parameter2>$(FcReceptorUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcKeyId</_Parameter1>
      <_Parameter2>$(FcKeyId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcPantallasDeSesion</_Parameter1>
      <_Parameter2>$(FcPantallasDeSesion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcModoDeIngreso</_Parameter1>
      <_Parameter2>$(FcModoDeIngreso)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcOidcAutoridad</_Parameter1>
      <_Parameter2>$(FcOidcAutoridad)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FcOidcClienteId</_Parameter1>
      <_Parameter2>$(FcOidcClienteId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Archivos que viajan dentro del APK (o del .app de iOS, como recursos del bundle).
         FileSystem.OpenAppPackageFileAsync los lee por su LogicalName en las dos plataformas. -->
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- P2 — La semilla: una copia de la carpeta del canal ({canal}/puente-{mayor}/: indice.json, su firma,
         paquetes/ y definiciones/) que el guion deja en Demo/semilla/. Se instala en el primer arranque. -->
    <MauiAsset Include="../../semilla/**" Exclude="../../semilla/**/.gitkeep;../../semilla/**/README*"
               LogicalName="semilla/%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- P2 — El conjunto de claves embebido: sólo la pública de demostración. La privada nunca entra al APK. -->
    <MauiAsset Include="../../claves/publica-demo.pem" Condition="Exists('../../claves/publica-demo.pem')"
               LogicalName="claves/publica-demo.pem" />
  </ItemGroup>

  <!-- P2 — Sólo HTTPS. La configuración de red de Android (@xml/network_security_config, citada en
       AndroidManifest.xml) sale de una de dos variantes de Platforms/Android/Red/:
         - ConCaDeDemo/: en Debug, si existe claves/tls/ca_demo_tls.crt («scripts/guion.sh tls»). El APK depurable
           confía además en esa CA, para llegar al receptor didáctico sin túnel público (P11).
         - SinCa/: en cualquier otro caso. Sólo las autoridades del sistema.
       Android exige nombres de recurso con [a-z0-9_.]: por eso las carpetas y la CA se llaman así. -->
  <PropertyGroup>
    <_CaDeDemo>$(MSBuildThisFileDirectory)../../claves/tls/ca_demo_tls.crt</_CaDeDemo>
    <_ConfigDeRed Condition="'$(Configuration)' == 'Debug' And Exists('$(_CaDeDemo)')">ConCaDeDemo</_ConfigDeRed>
    <_ConfigDeRed Condition="'$(_ConfigDeRed)' == ''">SinCa</_ConfigDeRed>
  </PropertyGroup>

  <!-- En iOS no hay un archivo equivalente que el binario lleve: la app usa NSUrlSession con App Transport Security
       por defecto, sin excepciones en Info.plist (sólo HTTPS, TLS 1.2+, certificados válidos). Para llegar al receptor
       didáctico con la CA de demostración, la CA se instala en el SIMULADOR, no en la app:
         xcrun simctl keychain booted add-root-cert claves/tls/ca_demo_tls.crt
       Así un binario de iOS nunca confía en la CA de demostración por sí mismo (README.md, «El cascarón en iOS»). -->
  <ItemGroup>
    <None Remove="Platforms/Android/Red/**" />
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <AndroidResource Include="Platforms/Android/Red/$(_ConfigDeRed)/network_security_config.xml"
                     Link="Platforms/Android/Resources/xml/network_security_config.xml" />
    <AndroidResource Include="$(_CaDeDemo)" Condition="'$(_ConfigDeRed)' == 'ConCaDeDemo'"
                     Link="Platforms/Android/Resources/raw/ca_demo_tls.crt" />
  </ItemGroup>

  <!-- P5 — Las consultas precompiladas de Data/Compilado/ son interceptores de C#: el compilador sólo los acepta
       desde los espacios de nombres listados acá. -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- P5 — EF Core SQLite detrás de IDb (D-05: S2). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(VersionEfCore)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FrameworkConcept.Core/FrameworkConcept.Core.csproj" />
  </ItemGroup>

</Project>
