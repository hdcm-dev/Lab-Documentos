<!-- P7, folio 023 ítem 4 — Atribución: las cuatro versiones (cascarón, puente, contenido, definición), el canal y la
     huella del contrato, para atribuir un error de producción a versiones exactas. Además el estado del actualizador,
     el motor web, la base y el outbox con su carta muerta (P5). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrameworkConcept.Shell.Pages.DiagnosticoPage"
             Title="Diagnóstico">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Actualizar" Clicked="AlActualizar" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout x:Name="Filas" Padding="16" Spacing="4" />
    </ScrollView>
</ContentPage>
