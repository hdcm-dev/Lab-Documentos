<?xml version="1.0" encoding="utf-8" ?>
<!-- C-3 de E01, P1 — «Actualizá el WebView». El contenido Blazor de .NET 10 necesita Android System WebView 94 o
     mayor; con uno más viejo (el 83 del emulador del laboratorio) el runtime no arranca. El contenido no se activa:
     así no queda marcado como fallido por una causa que no es suya. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrameworkConcept.Shell.Pages.WebViewViejoPage"
             Title="Actualizá el WebView">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Hay que actualizar el WebView del sistema" FontSize="22" FontAttributes="Bold" />
            <Label Text="Las pantallas de esta app se dibujan con «Android System WebView». La versión instalada en este teléfono es más vieja que la que necesitan." />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <Label Text="Instalada:" FontAttributes="Bold" />
                <Label x:Name="Instalada" Grid.Column="1" />
                <Label Text="Mínima:" FontAttributes="Bold" Grid.Row="1" />
                <Label x:Name="Minima" Grid.Row="1" Grid.Column="1" />
                <Label Text="Proveedor:" FontAttributes="Bold" Grid.Row="2" />
                <Label x:Name="Proveedor" Grid.Row="2" Grid.Column="1" />
            </Grid>
            <Label Text="Actualizala desde Play Store («Android System WebView») y volvé a abrir la app. Tus datos y las encuestas sin enviar siguen guardados; se envían solos cuando hay red." />
            <Button Text="Abrir Play Store" Clicked="AlAbrirTienda" />
            <Button Text="Diagnóstico" Clicked="AlAbrirDiagnostico" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
