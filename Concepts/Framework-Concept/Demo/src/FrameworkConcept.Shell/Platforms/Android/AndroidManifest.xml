<?xml version="1.0" encoding="utf-8"?>
<!-- El «manifiesto de la app» (P10, glosario): sólo cambia por tienda. P12: declara sólo lo que el
     catálogo implementa (Core/Contracts/Puente/CatalogoDeCapacidades.cs):
       network.status → ACCESS_NETWORK_STATE
       auth.session   → USE_BIOMETRIC y <queries> CustomTabsService (folio 038; DISENO-RED-Y-AUTENTICACION.md §7)
     INTERNET lo usa el actualizador para el canal, no es una capacidad del contenido. La compuerta compara este
     archivo con el catálogo (P8). La actividad del redirect OIDC (com.frameworkconcept.demo://callback) la declara
     el atributo [IntentFilter] de Shell/Auth/CallbackDeAutenticacion.cs, no este archivo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- P2: sólo HTTPS; ver Platforms/Android/Red/ -->
	<application android:allowBackup="true" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<queries>
		<intent>
			<action android:name="android.support.customtabs.action.CustomTabsService" />
		</intent>
	</queries>
</manifest>
