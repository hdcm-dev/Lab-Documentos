<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- P4 — Grupo de acceso del Keychain: sólo el de la propia app. En el simulador hace falta para que el Keychain
     acepte el ítem del cofre (sin él, errSecMissingEntitlement -34018); en un teléfono lo valida el perfil. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.frameworkconcept.demo</string>
	</array>
</dict>
</plist>
