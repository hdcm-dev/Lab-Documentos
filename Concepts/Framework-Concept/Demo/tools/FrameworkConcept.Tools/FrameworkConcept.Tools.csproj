<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramientas de quien publica (P2, P13): claves de demostración, empaquetar contenido, publicar una
       definición, firmar el índice del canal, retirar una versión, alterar el índice para la demo de rechazo,
       verificar lo publicado como lo haría el teléfono, y regenerar la instantánea del contrato.
       Sin paquetes NuGet: la firma (ECDSA P-256) y el zip son de la plataforma. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FrameworkConcept.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FrameworkConcept.Core/FrameworkConcept.Core.csproj" />
  </ItemGroup>

</Project>
