{
  "openapi": "3.1.1",
  "info": {
    "title": "MovilidadUrbana.ApiWeb | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/encuestas/contador": {
      "get": {
        "tags": [
          "Encuestas"
        ],
        "summary": "Cuántas encuestas registró esta sesión.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContadorDeEncuestasDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/encuestas/pasos/{paso}/validacion": {
      "post": {
        "tags": [
          "Encuestas"
        ],
        "summary": "Valida un paso —1, 2 o 3— sin registrar nada.",
        "parameters": [
          {
            "name": "paso",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidacionDePasoDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/encuestas": {
      "post": {
        "tags": [
          "Encuestas"
        ],
        "summary": "Registra una encuesta completa. Valida los tres pasos antes de guardar.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EncuestaRegistradaDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/localidades": {
      "get": {
        "tags": [
          "Localidades"
        ],
        "summary": "Lista las localidades de la sesión.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocalidadDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Localidades"
        ],
        "summary": "Da de alta una localidad.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalidadDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/localidades/{id}": {
      "get": {
        "tags": [
          "Localidades"
        ],
        "summary": "Devuelve una localidad por su identificador.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalidadDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Localidades"
        ],
        "summary": "Modifica una localidad existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LocalidadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalidadDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Localidades"
        ],
        "summary": "Da de baja una localidad.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CampoDeResumenDto": {
        "required": [
          "clave",
          "etiqueta",
          "valor"
        ],
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "etiqueta": {
            "type": "string"
          },
          "valor": {
            "type": "string"
          }
        },
        "description": "Una fila de la ficha de revisión, ya formateada."
      },
      "ContadorDeEncuestasDto": {
        "required": [
          "cantidad"
        ],
        "type": "object",
        "properties": {
          "cantidad": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Cuántas encuestas registró esta sesión."
      },
      "EncuestaRegistradaDto": {
        "required": [
          "id",
          "registradaEn",
          "resumen"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "registradaEn": {
            "type": "string",
            "format": "date-time"
          },
          "resumen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampoDeResumenDto"
            }
          }
        },
        "description": "La encuesta registrada y su ficha de revisión."
      },
      "EncuestaRequest": {
        "required": [
          "nombre",
          "edad",
          "localidad",
          "medios",
          "frecuencia",
          "distancia",
          "minutos",
          "motivo"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "type": [
              "null",
              "string"
            ]
          },
          "edad": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "localidad": {
            "type": [
              "null",
              "string"
            ]
          },
          "medios": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "frecuencia": {
            "type": [
              "null",
              "string"
            ]
          },
          "distancia": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "minutos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "motivo": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Los tres pasos de la encuesta, en un solo envío."
      },
      "LocalidadDto": {
        "required": [
          "id",
          "nombre",
          "provincia",
          "codigoPostal",
          "habitantes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "nombre": {
            "type": "string"
          },
          "provincia": {
            "type": "string"
          },
          "codigoPostal": {
            "type": "string"
          },
          "habitantes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Una localidad tal como la expone la API."
      },
      "LocalidadRequest": {
        "required": [
          "nombre",
          "provincia",
          "codigoPostal",
          "habitantes"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "type": [
              "null",
              "string"
            ]
          },
          "provincia": {
            "type": [
              "null",
              "string"
            ]
          },
          "codigoPostal": {
            "type": [
              "null",
              "string"
            ]
          },
          "habitantes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Lo que el cliente envía para dar de alta o modificar una localidad."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ValidacionDePasoDto": {
        "required": [
          "paso",
          "valido",
          "errors"
        ],
        "type": "object",
        "properties": {
          "paso": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "valido": {
            "type": "boolean"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "Resultado de validar un paso sin registrar nada."
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Encuestas"
    },
    {
      "name": "Localidades"
    }
  ]
}
