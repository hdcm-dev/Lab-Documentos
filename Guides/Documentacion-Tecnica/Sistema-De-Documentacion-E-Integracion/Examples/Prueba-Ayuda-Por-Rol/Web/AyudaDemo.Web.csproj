<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AyudaDemo.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- La ayuda viaja DENTRO del ensamblado: el manual es siempre el de la versión desplegada. -->
    <EmbeddedResource Include="Ayuda\**\*.md" LogicalName="Ayuda/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
