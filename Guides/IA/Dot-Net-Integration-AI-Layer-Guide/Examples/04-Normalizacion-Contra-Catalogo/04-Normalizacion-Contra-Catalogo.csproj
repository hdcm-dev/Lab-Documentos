<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nuevo: ejemplo 04 de la guía (§5.3 · OA-D2). Un solo proyecto, consola y pruebas a la vez:
       GenerateProgramFile=false deja Program.cs como punto de entrada y dotnet test corre Pruebas/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MovilidadUrbana.Asistente</RootNamespace>
    <AssemblyName>04-Normalizacion-Contra-Catalogo</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Include="entradas.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="entradas.extension.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pruebas/paridad-del-oraculo.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../_Comun/MovilidadUrbana.Dominio/MovilidadUrbana.Dominio.csproj" />
    <ProjectReference Include="../_Comun/MovilidadUrbana.Asistente.Comun/MovilidadUrbana.Asistente.Comun.csproj" />
  </ItemGroup>

</Project>
