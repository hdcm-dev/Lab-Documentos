<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nuevo: ejemplo 05 (plan §E.2). Un solo proyecto que es consola y suite NUnit a la vez:
       «dotnet run» corre la medición y «dotnet test» corre sus pruebas. GenerateProgramFile=false
       deja que el Program.cs del ejemplo sea el punto de entrada en lugar del que genera el Test SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MovilidadUrbana.Asistente</RootNamespace>
    <AssemblyName>ContextoCompletoConPrefijo</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="entradas.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="corpus/padron-de-localidades.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../_Comun/MovilidadUrbana.Dominio/MovilidadUrbana.Dominio.csproj" />
    <ProjectReference Include="../_Comun/MovilidadUrbana.Asistente.Comun/MovilidadUrbana.Asistente.Comun.csproj" />
  </ItemGroup>

</Project>
