<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nuevo: ejemplo 12 de la guía (§8.6 variante «un-agente», §8.8 variante «dos-agentes» · OA-D7).
       Un solo proyecto, consola y pruebas a la vez: GenerateProgramFile=false deja Program.cs como
       punto de entrada y dotnet test corre Pruebas/. Workflow de MAF (escalón 2, camino fijo en código)
       con una sola variable: cuántos agentes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MovilidadUrbana.Asistente</RootNamespace>
    <AssemblyName>12-Uno-O-Varios-Agentes</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- Sin el generador, los executors con [MessageHandler] no implementan ConfigureProtocol: CS0534 (ver 10). -->
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Generators" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Include="entradas.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../_Comun/MovilidadUrbana.Dominio/MovilidadUrbana.Dominio.csproj" />
    <ProjectReference Include="../_Comun/MovilidadUrbana.Persistencia/MovilidadUrbana.Persistencia.csproj" />
    <ProjectReference Include="../_Comun/MovilidadUrbana.Asistente.Comun/MovilidadUrbana.Asistente.Comun.csproj" />
  </ItemGroup>

</Project>
