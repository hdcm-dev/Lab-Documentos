<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nuevo: ejemplo 17 de la guía (§12.1–§12.3 · OA-O1). Un solo proyecto, consola y pruebas a la
       vez: GenerateProgramFile=false deja Program.cs como punto de entrada y «dotnet test» corre
       Pruebas/. Paquetes de la fila de §E.2: OpenTelemetry y su exportador en memoria (los spans y
       las métricas se leen en el mismo proceso, sin colector) y Caching.Memory (la caché que recibe
       UseDistributedCache). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MovilidadUrbana.Asistente</RootNamespace>
    <AssemblyName>17-Observabilidad-Y-Pipeline</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="entradas.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../_Comun/MovilidadUrbana.Dominio/MovilidadUrbana.Dominio.csproj" />
    <ProjectReference Include="../_Comun/MovilidadUrbana.Asistente.Comun/MovilidadUrbana.Asistente.Comun.csproj" />
  </ItemGroup>

</Project>
