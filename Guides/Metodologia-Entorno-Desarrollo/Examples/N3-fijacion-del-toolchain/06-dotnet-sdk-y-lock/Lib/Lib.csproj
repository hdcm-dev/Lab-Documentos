<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sin ninguna PackageReference. IsTrimmable hace que el SDK agregue un paquete implícito
       (Microsoft.NET.ILLink.Tasks) cuya versión depende del SDK que restaura. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
