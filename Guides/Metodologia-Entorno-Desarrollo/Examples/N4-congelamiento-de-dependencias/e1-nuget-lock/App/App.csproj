<Project Sdk="Microsoft.NET.Sdk">
  <!-- E1 de N4: un proyecto ejecutable que congela su grafo con packages.lock.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Opt-in al lock file: restore escribe packages.lock.json junto al .csproj. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Una dependencia directa que trae varias transitivas (Options, Primitives, DI...). -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>
</Project>
