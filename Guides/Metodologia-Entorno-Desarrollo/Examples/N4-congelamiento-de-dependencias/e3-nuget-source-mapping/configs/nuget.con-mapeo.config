<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear: no hereda fuentes de la configuración de usuario o de máquina. -->
    <clear />
    <add key="interno" value="/tmp/feeds/interno" />
    <add key="publico" value="/tmp/feeds/publico" />
  </packageSources>
  <packageSourceMapping>
    <!-- Contoso.* SÓLO desde el feed interno, aunque el público tenga el mismo Id. -->
    <packageSource key="interno">
      <package pattern="Contoso.*" />
    </packageSource>
    <!-- Todo lo demás, del público (en un repo real sería nuget.org). -->
    <packageSource key="publico">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
