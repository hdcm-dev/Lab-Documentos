<?xml version="1.0" encoding="utf-8"?>
<!-- Mapeo que no cubre Contoso.*: una vez que hay mapeo, TODO paquete debe estar mapeado. -->
<configuration>
  <packageSources>
    <clear />
    <add key="interno" value="/tmp/feeds/interno" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="interno">
      <package pattern="Fabrikam.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
