<?xml version="1.0" encoding="utf-8"?>
<!-- Dos fuentes y ningún mapeo: NuGet puede bajar Contoso.Util de cualquiera. -->
<configuration>
  <packageSources>
    <clear />
    <add key="interno" value="/tmp/feeds/interno" />
    <add key="publico" value="/tmp/feeds/publico" />
  </packageSources>
</configuration>
