// devcontainer.json admite comentarios (JSON con comentarios).
{
  "name": "n5-demo-digest",
  // La etiqueta queda como referencia legible; el contenido lo decide el digest.
  "image": "mcr.microsoft.com/dotnet/sdk:8.0@sha256:78235e09001f52b6592c458ac010775ebac6725422e80cd0c1650590f67b2743",
  "features": {
    // Feature referenciada por versión semántica mayor; la versión exacta y su digest
    // quedan en .devcontainer/devcontainer-lock.json, que se versiona junto a este archivo.
    "ghcr.io/devcontainers/features/node:1": { "version": "22.11.0" }
  },
  "containerEnv": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_NOLOGO": "1" },
  // Corre una vez al crear el contenedor: deja constancia de las versiones efectivas.
  "postCreateCommand": "dotnet --version && node --version"
}
