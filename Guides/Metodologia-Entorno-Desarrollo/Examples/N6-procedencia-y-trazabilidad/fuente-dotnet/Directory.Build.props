<Project>
  <!-- Patrón recomendado por Microsoft: ContinuousIntegrationBuild sólo en la CI.
       Acá se usa la variable genérica CI (la definen GitHub Actions y GitLab CI) o la de Azure Pipelines. -->
  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
