<!-- Proyecto JavaScript de Visual Studio (JSPS, .esproj) TAL COMO VIENE:
     en Build y Restore corre `npm install` (ShouldRunNpmInstall = true por defecto). -->
<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <PropertyGroup>
    <BuildOutputFolder>$(MSBuildProjectDirectory)/dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
