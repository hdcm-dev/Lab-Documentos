# Variante "una imagen por componente": cada ecosistema construye en SU imagen
# oficial (fijada por digest) y pasa su salida a la siguiente etapa. El contexto
# de build es la carpeta solucion/.
ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0@sha256:78235e09001f52b6592c458ac010775ebac6725422e80cd0c1650590f67b2743
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
ARG PY_IMAGE=python:3.12.15-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21

FROM ${UV_IMAGE} AS uv

# --- Python: genera Datos.g.cs con el intérprete de la imagen oficial.
FROM ${PY_IMAGE} AS py
COPY --from=uv /uv /usr/local/bin/
WORKDIR /src/tools/gen
COPY tools/gen/ ./
# tools/gen/ incluye .python-version: uv exige ESE parche y la imagen debe traerlo.
ENV UV_PYTHON_PREFERENCE=only-system UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
RUN uv run --locked python gen.py dist/Datos.g.cs

# --- Node: construye el bundle.
FROM ${NODE_IMAGE} AS web
WORKDIR /src/web
COPY web/ ./
RUN npm ci --no-audit --no-fund && npm run build

# --- .NET: consume las dos salidas; MSBuild no llama a nadie.
FROM ${SDK_IMAGE} AS net
WORKDIR /src
COPY global.json nuget.config Directory.Packages.props ./
COPY src/ src/
COPY --from=py  /src/tools/gen/dist/ tools/gen/dist/
COPY --from=web /src/web/dist/ web/dist/
RUN dotnet restore src/Saludo --locked-mode \
 && dotnet build src/Saludo -c Release --no-restore -p:ConstruirPoliglota=false \
      -p:ContinuousIntegrationBuild=true \
 && sha256sum src/Saludo/bin/Release/net8.0/Saludo.dll \
 && dotnet src/Saludo/bin/Release/net8.0/Saludo.dll

# --- Artefacto: sólo la salida de la build (para exportarla con su procedencia).
FROM scratch AS artefacto
COPY --from=net /src/src/Saludo/bin/Release/net8.0/ /
