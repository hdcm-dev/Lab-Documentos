{
  "name": "Prueba · Ayuda por rol",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "appPort": ["5190:5190"],
  "forwardPorts": [5190],
  "containerEnv": {
    "ASPNETCORE_URLS": "http://0.0.0.0:5190",
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "postCreateCommand": "dotnet restore Web/AyudaDemo.Web.csproj && dotnet restore Consola/Spike.csproj",
  "customizations": {
    "vscode": { "extensions": ["ms-dotnettools.csdevkit"] }
  }
}
