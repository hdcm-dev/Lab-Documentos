{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ayuda.schema.json",
  "title": "Frontmatter de página de ayuda al usuario final (CL-06; portado de la propuesta de C-VERIFICACION, Q14/Q38)",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 3, "maxLength": 160 },
    "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" } },
    "order": { "type": "integer" },
    "topic": { "type": "string" },
    "traces": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+@\\d+\\.\\d+$" } },
    "translation_of": { "type": "string", "pattern": "^[a-z]{2}/[a-z0-9/-]+\\.md(@[A-Z][A-Z0-9]*(-[A-Z0-9]+)+@\\d+\\.\\d+)?$" }
  },
  "oneOf": [ { "required": ["roles"] }, { "required": ["translation_of"] } ]
}
