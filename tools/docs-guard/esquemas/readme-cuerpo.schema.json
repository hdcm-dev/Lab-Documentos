{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "readme-cuerpo.schema.json",
  "title": "Frontmatter del README de un cuerpo de guía (N09 §7: corpus_id y version sólo acá)",
  "type": "object",
  "required": ["corpus_id", "version", "title", "description"],
  "properties": {
    "corpus_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10, "maxLength": 160 }
  }
}
